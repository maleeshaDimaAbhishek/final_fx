<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="root" stylesheets="@../style/AdminDashBoard.css"
            fx:controller="edu.MD.Fx_final.controller.AdminDashboardController"
            style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e05f89, #563d7c);">
    <top>
        <HBox styleClass="top-bar" spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <Label text="Library Management System - Admin Dashboard" styleClass="header-title">
                <font>
                    <Font name="Poppins SemiBold" size="24"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="adminNameLabel" text="Admin: John Doe" styleClass="admin-name">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Label>
            <Button fx:id="logoutButton" onAction="#handleLogoutAction" text="Logout" styleClass="logout-btn">
                <font>
                    <Font name="Poppins Medium" size="12"/>
                </font>
            </Button>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="5" prefWidth="250">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            <Label text="NAVIGATION" styleClass="sidebar-header">
                <font>
                    <Font name="Poppins SemiBold" size="12"/>
                </font>
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </Label>
            <Button fx:id="viewUsersBtn" onAction="#handleViewUserOnAction" text="View Users"  styleClass="nav-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Button>
            <Button fx:id="viewStaffBtn" onAction="#handleViewStaffAction" text="View Staff" styleClass="nav-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Button>
            <Button fx:id="viewPaymentsBtn" onAction="#handleViewPaymentOnAction" text="View Payments" styleClass="nav-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Button>
            <Button fx:id="viewBorrowingsBtn" onAction="#handleViewBorrowingsOnAction" text="Book Borrowings" styleClass="nav-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Button>
            <Button fx:id="viewBooksBtn" onAction="#handleViewBooksOnAction" text="View Books" styleClass="nav-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Regular" size="14"/>
                </font>
            </Button>
            <Separator>
                <VBox.margin>
                    <Insets top="15" bottom="15"/>
                </VBox.margin>
            </Separator>
            <Label text="ACTIONS" styleClass="sidebar-header">
                <font>
                    <Font name="Poppins SemiBold" size="12"/>
                </font>
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </Label>
            <Button fx:id="registerStaffBtn" onAction="#handleRegisterStaffOnAction" text="Register Staff" styleClass="action-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Medium" size="14"/>
                </font>
            </Button>
            <Button fx:id="manageUsersBtn" onAction="#handleManageUserOnAction" text="Manage Users" styleClass="action-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Medium" size="14"/>
                </font>
            </Button>
            <Button fx:id="manageStaffBtn" onAction="#handleManageStaffOnAction" text="Manage Staff" styleClass="action-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Medium" size="14"/>
                </font>
            </Button>
            <Button fx:id="manageBooksBtn" onAction="#handleManageBooksOnAction" text="Manage Books" styleClass="action-btn" maxWidth="Infinity">
                <font>
                    <Font name="Poppins Medium" size="14"/>
                </font>
            </Button>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <VBox fx:id="dashboardView" spacing="20">
                <Label text="Dashboard Overview" styleClass="content-title">
                    <font>
                        <Font name="Poppins Bold" size="28"/>
                    </font>
                </Label>
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        <Label text="Total Users" styleClass="stat-label">
                            <font>
                                <Font name="Poppins Regular" size="14"/>
                            </font>
                        </Label>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value">
                            <font>
                                <Font name="Poppins Bold" size="32"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        <Label text="Total Staff" styleClass="stat-label">
                            <font>
                                <Font name="Poppins Regular" size="14"/>
                            </font>
                        </Label>
                        <Label fx:id="totalStaffLabel" text="0" styleClass="stat-value">
                            <font>
                                <Font name="Poppins Bold" size="32"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="2">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        <Label text="Total Books" styleClass="stat-label">
                            <font>
                                <Font name="Poppins Regular" size="14"/>
                            </font>
                        </Label>
                        <Label fx:id="totalBooksLabel" text="0" styleClass="stat-value">
                            <font>
                                <Font name="Poppins Bold" size="32"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="3">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        <Label text="Active Borrowings" styleClass="stat-label">
                            <font>
                                <Font name="Poppins Regular" size="14"/>
                            </font>
                        </Label>
                        <Label fx:id="activeBorrowingsLabel" text="0" styleClass="stat-value">
                            <font>
                                <Font name="Poppins Bold" size="32"/>
                            </font>
                        </Label>
                    </VBox>
                </GridPane>
                <VBox spacing="15" styleClass="activity-section">
                    <Label text="Recent Activity" styleClass="section-title">
                        <font>
                            <Font name="Poppins SemiBold" size="20"/>
                        </font>
                    </Label>
                    <TableView fx:id="recentActivityTable" styleClass="data-table">
                        <columns>
                            <TableColumn text="Date" prefWidth="150" fx:id="activityDateCol"/>
                            <TableColumn text="Activity Type" prefWidth="200" fx:id="activityTypeCol"/>
                            <TableColumn text="Description" prefWidth="400" fx:id="activityDescCol"/>
                            <TableColumn text="User/Staff" prefWidth="200" fx:id="activityUserCol"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
            <VBox fx:id="usersView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="User Management" styleClass="content-title">
                        <font>
                            <Font name="Poppins Bold" size="28"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchUsersField" promptText="Search users..." styleClass="search-field" prefWidth="250">
                        <font>
                            <Font name="Poppins Regular" size="13"/>
                        </font>
                    </TextField>
                </HBox>
                <TableView fx:id="usersTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="User ID" prefWidth="100" fx:id="userIdCol"/>
                        <TableColumn text="Name" prefWidth="200" fx:id="userNameCol"/>
                        <TableColumn text="Email" prefWidth="250" fx:id="userEmailCol"/>
                        <TableColumn text="Phone" prefWidth="150" fx:id="userPhoneCol"/>
                        <TableColumn text="Join Date" prefWidth="150" fx:id="userJoinDateCol"/>
                        <TableColumn text="Status" prefWidth="100" fx:id="userStatusCol"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="updateUserBtn" text="Update User" styleClass="primary-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                    <Button fx:id="deleteUserBtn" text="Delete User" styleClass="danger-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                </HBox>
            </VBox>
            <VBox fx:id="staffView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Staff Management" styleClass="content-title">
                        <font>
                            <Font name="Poppins Bold" size="28"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchStaffField" promptText="Search staff..." styleClass="search-field" prefWidth="250">
                        <font>
                            <Font name="Poppins Regular" size="13"/>
                        </font>
                    </TextField>
                </HBox>
                <TableView fx:id="staffTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Staff ID" prefWidth="100" fx:id="staffIdCol"/>
                        <TableColumn text="Name" prefWidth="200" fx:id="staffNameCol"/>
                        <TableColumn text="Email" prefWidth="250" fx:id="staffEmailCol"/>
                        <TableColumn text="Phone" prefWidth="150" fx:id="staffPhoneCol"/>
                        <TableColumn text="Role" prefWidth="150" fx:id="staffRoleCol"/>
                        <TableColumn text="Join Date" prefWidth="150" fx:id="staffJoinDateCol"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="updateStaffBtn" text="Update Staff" styleClass="primary-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                    <Button fx:id="deleteStaffBtn" text="Delete Staff" styleClass="danger-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                </HBox>
            </VBox>
            <VBox fx:id="paymentsView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Payment Details" styleClass="content-title">
                        <font>
                            <Font name="Poppins Bold" size="28"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchPaymentsField" promptText="Search payments..." styleClass="search-field" prefWidth="250">
                        <font>
                            <Font name="Poppins Regular" size="13"/>
                        </font>
                    </TextField>
                </HBox>
                <TableView fx:id="paymentsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Payment ID" prefWidth="120" fx:id="paymentIdCol"/>
                        <TableColumn text="User Name" prefWidth="200" fx:id="paymentUserCol"/>
                        <TableColumn text="Amount" prefWidth="120" fx:id="paymentAmountCol"/>
                        <TableColumn text="Type" prefWidth="150" fx:id="paymentTypeCol"/>
                        <TableColumn text="Date" prefWidth="150" fx:id="paymentDateCol"/>
                        <TableColumn text="Status" prefWidth="120" fx:id="paymentStatusCol"/>
                        <TableColumn text="Method" prefWidth="150" fx:id="paymentMethodCol"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox fx:id="borrowingsView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Book Borrowing Details" styleClass="content-title">
                        <font>
                            <Font name="Poppins Bold" size="28"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchBorrowingsField" promptText="Search borrowings..." styleClass="search-field" prefWidth="250">
                        <font>
                            <Font name="Poppins Regular" size="13"/>
                        </font>
                    </TextField>
                </HBox>
                <TableView fx:id="borrowingsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Borrow ID" prefWidth="100" fx:id="borrowIdCol"/>
                        <TableColumn text="User Name" prefWidth="180" fx:id="borrowUserCol"/>
                        <TableColumn text="Book Title" prefWidth="250" fx:id="borrowBookCol"/>
                        <TableColumn text="Borrow Date" prefWidth="130" fx:id="borrowDateCol"/>
                        <TableColumn text="Due Date" prefWidth="130" fx:id="dueDateCol"/>
                        <TableColumn text="Return Date" prefWidth="130" fx:id="returnDateCol"/>
                        <TableColumn text="Status" prefWidth="100" fx:id="borrowStatusCol"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox fx:id="booksView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Book Management" styleClass="content-title">
                        <font>
                            <Font name="Poppins Bold" size="28"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchBooksField" promptText="Search books..." styleClass="search-field" prefWidth="250">
                        <font>
                            <Font name="Poppins Regular" size="13"/>
                        </font>
                    </TextField>
                </HBox>
                <TableView fx:id="booksTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Book ID" prefWidth="100" fx:id="bookIdCol"/>
                        <TableColumn text="Title" prefWidth="250" fx:id="bookTitleCol"/>
                        <TableColumn text="Author" prefWidth="200" fx:id="bookAuthorCol"/>
                        <TableColumn text="ISBN" prefWidth="130" fx:id="bookIsbnCol"/>
                        <TableColumn text="Category" prefWidth="150" fx:id="bookCategoryCol"/>
                        <TableColumn text="Available" prefWidth="80" fx:id="bookAvailableCol"/>
                        <TableColumn text="Total" prefWidth="80" fx:id="bookTotalCol"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="addBookBtn" text="Add Book" styleClass="success-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                    <Button fx:id="updateBookBtn" text="Update Book" styleClass="primary-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                    <Button fx:id="removeBookBtn" text="Remove Book" styleClass="danger-btn">
                        <font>
                            <Font name="Poppins Medium" size="13"/>
                        </font>
                    </Button>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>