<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="500" prefWidth="700" spacing="0" stylesheets="@login.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="edu.MD.Fx_final.controller.LoginController">

    <!-- Left side image -->
    <StackPane fx:id="leftPane" HBox.hgrow="ALWAYS">
        <ImageView fx:id="libraryImage" fitWidth="350" pickOnBounds="true" preserveRatio="true" />
    </StackPane>

    <!-- Right side login area -->
    <StackPane fx:id="rightPane" styleClass="right-pane" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="20">
            <!-- Title -->
            <Label styleClass="title-label" text="BookWorm.lk" />

            <!-- Login box -->
            <VBox alignment="CENTER" spacing="15" styleClass="login-box">
                <Label styleClass="login-heading" text="Login" />

                <VBox alignment="CENTER_LEFT" spacing="10" styleClass="input-box">
                    <Label styleClass="input-label" text="User Name:" />
                    <TextField fx:id="txtUsername" promptText="Enter username" />
                </VBox>

                <Button fx:id="btnLogin" onAction="#handleLoginAction" styleClass="login-button" text="Get OTP" />

                <Label styleClass="forget-label" text="Don't  Have Account" />

                <ImageView fx:id="bookImage" fitWidth="100" preserveRatio="true" />
            </VBox>
        </VBox>
    </StackPane>
</HBox>
