<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.MD.Fx_final.controller.OTPDialogController"
            prefWidth="400" prefHeight="250"
            stylesheets="@../style/otp-dialog.css"
            style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e05f89, #563d7c);
                   -fx-background-radius: 15;
                   -fx-padding: 20;">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- Header -->
        <Label text="OTP Verification"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;
                      -fx-text-alignment: center;" />

        <Label text="Enter the 6-digit code sent to your email"
               wrapText="true"
               style="-fx-text-fill: #f5f5f5;
                      -fx-font-size: 13px;
                      -fx-text-alignment: center;" />

        <!-- OTP Input -->
        <TextField fx:id="txtOTP"
                   promptText="Enter OTP"
                   alignment="CENTER"
                   maxWidth="250"
                   style="-fx-background-radius: 10;
                          -fx-background-color: white;
                          -fx-font-size: 14px;
                          -fx-padding: 10;" />

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button text="Verify" fx:id="btnVerify"
                    onAction="#onVerifyClick"
                    style="-fx-background-color: #4CAF50;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 8 20;" />

            <Button text="Cancel" fx:id="btnCancel"
                    onAction="#onCancelClick"
                    style="-fx-background-color: #f44336;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 8 20;" />
        </HBox>
    </VBox>
</AnchorPane>
